{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "allowImportingTsExtensions": false,
    "rootDir": "src",
    "outDir": "lib"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
